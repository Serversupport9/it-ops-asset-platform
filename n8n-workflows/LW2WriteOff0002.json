{"updatedAt":"2026-09-01T10:08:10.321Z","createdAt":"2026-08-25T16:58:46.493Z","id":"LW2WriteOff0002","name":"Portal - Write Off Asset","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"portal-write-off","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"4dca554a-24db-4f21-9e0d-027a1b00c8e5","name":"Webhook","webhookId":"20371f12-5f0c-4fbb-8377-eeda9664a716"},{"parameters":{"operation":"executeQuery","query":"WITH input AS ( SELECT UPPER(TRIM($1)) AS in_asset_id ), a AS (SELECT ast.* FROM assets ast, input i WHERE ast.asset_id = i.in_asset_id), al AS ( SELECT alloc.* FROM asset_allocations alloc, input i WHERE alloc.asset_id = i.in_asset_id AND alloc.status = 'active' ), holder AS (SELECT emp.* FROM employees emp, al WHERE emp.employee_id = al.employee_id) SELECT i.in_asset_id AS asset_id, al.allocation_id, al.employee_id, holder.name AS employee_name, CASE WHEN a.asset_id IS NULL THEN 'Asset Id \"' || i.in_asset_id || '\" does not exist.' WHEN al.allocation_id IS NULL THEN 'Asset ' || i.in_asset_id || ' has no active allocation - nothing to mark lost/written off.' ELSE NULL END AS rejection_reason FROM input i LEFT JOIN a ON TRUE LEFT JOIN al ON TRUE LEFT JOIN holder ON TRUE;","options":{"queryReplacement":"={{ $json.body.asset_id }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[208,0],"id":"fbbb52b3-a8ec-4249-9889-0170efdaaba7","name":"Validate","credentials":{"postgres":{"id":"PFqIGHmn61JbtBF4","name":"Postgres account"}},"alwaysOutputData":true},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"186d06d8-855c-43ce-a67a-912b01d06e96","leftValue":"={{ !$json.rejection_reason }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"p