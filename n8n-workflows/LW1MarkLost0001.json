{"updatedAt":"2026-09-01T10:07:36.395Z","createdAt":"2026-08-25T16:58:42.429Z","id":"LW1MarkLost0001","name":"Portal - Mark Asset Lost","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"portal-mark-lost","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"a8c548e4-7e1d-4ff3-9323-94ca248e9527","name":"Webhook","webhookId":"c109179d-e18d-412c-8b8f-78280080b543"},{"parameters":{"operation":"executeQuery","query":"WITH input AS ( SELECT UPPER(TRIM($1)) AS in_asset_id ), a AS (SELECT ast.* FROM assets ast, input i WHERE ast.asset_id = i.in_asset_id), al AS ( SELECT alloc.* FROM asset_allocations alloc, input i WHERE alloc.asset_id = i.in_asset_id AND alloc.status = 'active' ), holder AS (SELECT emp.* FROM employees emp, al WHERE emp.employee_id = al.employee_id) SELECT i.in_asset_id AS asset_id, al.allocation_id, al.employee_id, holder.name AS employee_name, CASE WHEN a.asset_id IS NULL THEN 'Asset Id \"' || i.in_asset_id || '\" does not exist.' WHEN al.allocation_id IS NULL THEN 'Asset ' || i.in_asset_id || ' has no active allocation - nothing to mark lost/written off.' ELSE NULL END AS rejection_reason FROM input i LEFT JOIN a ON TRUE LEFT JOIN al ON TRUE LEFT JOIN holder ON TRUE;","options":{"queryReplacement":"={{ $json.body.asset_id }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[208,0],"id":"6c2f8f9b-0123-4470-b9ba-9b0b55c76a1b","name":"Validate","credentials":{"postgres":{"id":"PFqIGHmn61JbtBF4","name":"Postgres account"}},"alwaysOutputData":true},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"1c1860ec-c2ba-4c74-8eeb-8a507f4bd423","leftValue":"={{ !$json.rejection_reason }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[416,0],"id":"182a9ce4-2c8c-4062-aa54-e0a347a30971","name":"If valid"},{"parameters":{"operation":"executeQuery","query":"WITH updated_alloc AS ( UPDATE asset_allocations SET status='lost', received_by=$2, return_notes=NULLIF(TRIM($3),'') WHERE allocation_id=$1 AND status='active' AND set_config('app.actor', 'n8n:Portal - Mark Asset Lost', true) IS NOT NULL RETURNING allocation_id, asset_id, employee_id ), updated_asset AS ( UPDATE assets SET asset_status='lost' WHERE asset_id = (SELECT asset_id FROM updated_alloc) RETURNING asset_id, asset_status ) SELECT ua.allocation_id, ua.asset_id, ua.employee_id, uas.asset_status FROM updated_alloc ua JOIN updated_asset uas ON true;","options":{"queryReplacement":"={{ $('Validate').item.json.allocation_id }}, {{ $('Webhook').item.json.body.decided_by }}, {{ $('Webhook').item.json.body.notes || ' ' }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[624,-80],"id":"1ce3521e-3e15-4509-85c5-145ef9a2d3f9","name":"Apply lost","credentials":{"postgres":{"id":"PFqIGHmn61JbtBF4","name":"Postgres account"}},"alwaysOutputData":true},{"parameters":{"respondWith":"json","responseBody":"={{ { \"allocation_id\": $('Apply lost').item.json.allocation_id, \"asset_id\": $('Apply lost').item.json.asset_id, \"status\": \"lost\" } }}","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1040,-80],"id":"bd66a7d1-f690-49a1-afc8-b9c927769fb0","name":"Respond lost"},{"parameters":{"operation":"executeQuery","query":"SELECT wc.phone_number, $1::text AS asset_id, $2::text AS employee_name, $3::text AS employee_id, $4::text AS decided_by FROM whatsapp_contacts wc JOIN app_users au ON au.employee_id = wc.employee_id WHERE au.role IN ('it','management','super_admin');","options":{"queryReplacement":"={{ $('Apply lost').item.json.asset_id }}, {{ $('Validate').item.json.employee_name }}, {{ $('Apply lost').item.json.employee_id }}, {{ $('Webhook').item.json.body.decided_by }}"}},"type