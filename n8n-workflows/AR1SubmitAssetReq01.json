{"updatedAt":"2026-09-01T10:05:46.687Z","createdAt":"2026-08-25T15:22:24.259Z","id":"AR1SubmitAssetReq01","name":"Portal - Submit Asset Request","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"portal-asset-request","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"668822b0-1b37-4883-a0ed-9929e7817caa","name":"Webhook","webhookId":"4c185a94-cbad-4521-908d-a24e8960a0e6"},{"parameters":{"operation":"executeQuery","query":"WITH input AS ( SELECT UPPER(TRIM($1)) AS in_employee_id, $2::int AS in_device_type_id, $3::int AS in_qty ), e AS (SELECT emp.* FROM employees emp, input i WHERE emp.employee_id = i.in_employee_id), dt AS (SELECT d.* FROM device_types d, input i WHERE d.device_type_id = i.in_device_type_id) SELECT i.in_employee_id AS employee_id, i.in_device_type_id AS device_type_id, dt.name AS device_type_name, i.in_qty AS requested_qty, CASE WHEN e.employee_id IS NULL THEN 'Employee code \"' || i.in_employee_id || '\" not found.' WHEN e.employment_status <> 'active' THEN 'Employee ' || e.name || ' has status \"' || e.employment_status || '\". Cannot submit requests.' WHEN e.party_type <> 'person' THEN 'Employee code \"' || i.in_employee_id || '\" is not a person account.' WHEN dt.device_type_id IS NULL THEN 'Unknown device type.' WHEN i.in_qty < 1 THEN 'Requested quantity must be at least 1.' ELSE NULL END AS rejection_reason FROM input i LEFT JOIN e ON TRUE LEFT JOIN dt ON TRUE;","options":{"queryReplacement":"={{ $json.body.employee_id }}, {{ $json.body.device_type_id }}, {{ $json.body.requested_qty }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[208,0],"id":"3b252533-f5b4-4b71-b0a4-d08794f1c9c3","name":"Validate submission","credentials":{"postgres":{"id":"PFqIGHmn61JbtBF4","name":"Postgres account"}},"alwaysOutputData":true},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"st