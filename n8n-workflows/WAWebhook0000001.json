responseMode":"responseNode"},"typeVersion":2.1},{"id":"wawh-sig-verify-0001","name":"Verify signature","type":"n8n-nodes-base.code","typeVersion":2,"position":[-380,120],"parameters":{"jsCode":"const crypto = require('crypto');\nconst secret = $env.WHATSAPP_APP_SECRET || '';\nconst req = $input.first();\n\n// raw body: n8n with rawBody:true stores base64 at binary.data.data\nlet raw;\nconst bin = req.binary && (req.binary.data || req.binary.body);\nif (bin && bin.data) {\n  raw = Buffer.from(bin.data, 'base64');\n} else if (typeof req.json.body === 'string') {\n  raw = Buffer.from(req.json.body, 'utf8');\n} else {\n  raw = Buffer.from(JSON.stringify(req.json.body || {}), 'utf8');\n}\n\nconst headers = req.json.headers || {};\nconst got = headers['x-hub-signature-256'] || headers['X-Hub-Signature-256'] || '';\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n\nlet valid = false;\ntry {\n  valid = got.length === expected.length &&\n          crypto.timingSafeEqual(Buffer.from(got), Buffer.from(expected));\n} catch (e) { valid = false; }\n\nlet payload = {};\ntry { payload = JSON.parse(raw.toString('utf8')); } catch (e) {}\n\nconsole.log('[wa-sig] rawlen=' + raw.length + ' got=' + String(got).slice(0, 24) +\n            ' exp=' + expected.slice(0, 24) + ' valid=' + valid);\n\nreturn [{ json: { valid, payload } }];"}},{"id":"wawh-sig-if-0001","name":"Signature valid?","type":"n8n-nodes-base.if","typeVersion":2,"position":[-160,120],"parameters":{"conditions":{"options":{"version":2,"caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"wawh-sig-cond-1","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.valid }}","rightValue":""}]}}},{"id":"wawh-reject-post-0001","name":"Reject (POST)","type":"n8n-nodes-base.respondToWebhook","position":[60,260],"parameters":{"options":{"responseCode":403},"respondWith":"json","responseBody":"={{ { \"detail\": \"verificati