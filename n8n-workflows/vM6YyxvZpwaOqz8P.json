{"updatedAt":"2026-09-01T10:08:44.605Z","createdAt":"2026-08-25T12:40:20.272Z","id":"vM6YyxvZpwaOqz8P","name":"Portal - Return Asset","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"portal-return","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"8fa1615e-6915-41c7-8239-beb5df824286","name":"Webhook","webhookId":"6b1556f9-d437-4a95-994c-1672b985e688"},{"parameters":{"operation":"executeQuery","query":"WITH input AS ( SELECT UPPER(TRIM($1)) AS in_asset_id, UPPER(TRIM($2)) AS in_employee_id ), a AS (SELECT ast.* FROM assets ast, input i WHERE ast.asset_id = i.in_asset_id), s AS (SELECT stg.* FROM stg_assets_sheet stg, input i WHERE stg.asset_id = i.in_asset_id), al AS ( SELECT alloc.* FROM asset_allocations alloc, input i WHERE alloc.asset_id = i.in_asset_id AND alloc.status = 'active' ), holder AS (SELECT emp.* FROM employees emp, al WHERE emp.employee_id = al.employee_id) SELECT i.in_asset_id AS asset_id, i.in_employee_id AS employee_id, al.allocation_id, al.employee_id AS holder_employee_id, holder.name AS holder_employee_name, a.qty, s.device_type AS before_device_type, s.location AS before_location, s.ipac_id AS before_ipac_id, s.employee_name AS before_employee_name, s.device_status AS before_device_status, s.final_status AS before_final_status, CASE WHEN a.asset_id IS NULL THEN 'Asset Id \"' || i.in_asset_id || '\" does not exist.' WHEN al.allocation_id IS NULL THEN 'Asset ' || i.in_asset_id || ' has no active allocation in Postgres. It may already be team-held, or was reassigned directly in the sheet — reconcile before processing a return.' WHEN al.employee_id <> i.in_employee_id THEN 'Asset ' || i.in_asset_id || ' is currently allocated to ' || al.employee_id || COALESCE(' (' || holder.name || ')', '') || ', not ' || i.in_employee_id || '.' ELSE NULL END AS rejection_reason FROM input i LEFT JOIN a ON TRUE LEFT JOIN s ON TRUE LEFT JOIN al ON TRUE LEFT JOIN holder ON TRUE;","options":{"queryReplacement":"={{ $json.body.asset_id }}, {{ $json.body.employee_id }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[208,0],"id":"d258edf0-7292-41af-8618-b026af8a5f2b","name":"Validate return","credentials":{"postgres":{"id":"PFqIGHmn61JbtBF4","name":"Postgres account"}},"alwaysOutputData":true},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"e7c08801-6c37-4fae-b28a-8d3cef4781a7","leftValue":"={{ !$json.rejection_reason }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[416,0],"id":"28c14d46-294f-4593-a3cb-a21f04dfebd3","name":"If valid"},{"parameters":{"operation":"executeQuery","query":"WITH updated_alloc AS ( UPDATE asset_allocations SET status='returned', returned_at=now(), received_by=$2, condition_in=$3, return_notes=NULLIF(TRIM($4),'') WHERE allocation_id=$1 AND status='active' AND set_config('app.actor', 'n8n:Portal - Return Asset', true) IS NOT NULL RETURNING allocation_id, asset_id, employee_id ), updated_asset AS ( UPDATE assets SET current_employee_id='IPACTM001', party_type='team', asset_status = CASE WHEN $3 IN ('Damaged','Not Working') THEN 'damaged' ELSE 'available' END WHERE asset_id = (SELECT asset_id FROM updated_alloc) RETURNING asset_id, asset_status ) SELECT ua.allocation_id, ua.asset_id, ua.employee_id, uas.asset_status FROM updated_alloc ua JOIN updated_asset uas ON true;","options":{"queryReplacement":"={{ $('Validate return').item.json.allocation_id }}, {{ $('Webhook').item.json.body.received_by }}, {{ $('Webhook').item.json.body.condition_in }}, {{ $('Webhook').item.json.body.notes || ' ' }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.7,"position":[624,-80],"id":"2d29d4c6-7147-4801-84eb-f227f99f4da2","name":"Apply return","credentials":{"postgres