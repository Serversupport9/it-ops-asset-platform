# Copy to .env and fill in real values. Never commit the real .env (gitignored).

# Postgres (shared by n8n, metabase, itops, and the webapp)
POSTGRES_USER=itops_admin
POSTGRES_PASSWORD=
POSTGRES_DB=itops

# n8n
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Asia/Kolkata
N8N_HOST=
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=
# Meta's WhatsApp Cloud API webhook verify token - compared against the hub.verify_token query
# param Meta sends during the Callback URL verification handshake (GET /webhook/whatsapp-inbound).
# Must exactly match the "Verify token" value entered in the Meta App Dashboard's Configure
# Webhooks step. In production this MUST be copied from the dev .env, not freshly regenerated -
# same exception pattern as WEBAPP_N8N_WEBHOOK_SECRET below.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret (developers.facebook.com -> App -> Settings -> Basic -> App Secret). Used by
# "Portal - WhatsApp Webhook" to verify the X-Hub-Signature-256 HMAC on every inbound POST before
# acting on APPROVE_/REJECT_ button taps. Same as the secret half of the n8n "WhatsApp OAuth
# account" credential. In production this MUST be the real value; dev can use any throwaway
# string as long as the signed test requests use the same one.
WHATSAPP_APP_SECRET=

# Web app (Phase 3.5b) - self-hosted, no AWS/Vercel/paid services
WEBAPP_API_PORT=8000
WEBAPP_WEB_PORT=8082
WEBAPP_JWT_SECRET=
WEBAPP_DB_ENC_KEY=
WEBAPP_METABASE_EMBED_SECRET=
# Shared secret FastAPI sends as the X-Webhook-Secret header when calling n8n's
# portal-password-reset-email webhook - must exactly match the value stored in n8n's
# "Portal Webhook Shared Secret" (httpHeaderAuth) credential, not just be present. In production
# this MUST be copied from the dev .env, not freshly generated - see docs/SETUP.md.
WEBAPP_N8N_WEBHOOK_SECRET=

# Public origins the browser actually hits - leave unset for local dev (defaults to
# localhost:<port> above). On any other host, set both to real reachable URLs, e.g.
# PUBLIC_APP_URL=https://itops.example.com and PUBLIC_METABASE_URL=https://metabase.example.com:
#   PUBLIC_APP_URL       - frontend origin. Mostly defense-in-depth (CORS) now that the
#                           frontend's own /api calls are same-origin via nginx - matters if
#                           anything else calls the API directly from a browser.
#   PUBLIC_METABASE_URL   - Metabase origin, loaded by the browser inside the dashboard iframe -
#                           this one is genuinely required in production, the browser loads it
#                           directly, not through any proxy. Needs its OWN public hostname
#                           (not a path under PUBLIC_APP_URL) - see docs/SETUP.md.
# Both need TLS in front (Caddy in this repo's case - see Caddyfile / docker-compose.prod.yml)
# for a real production deployment - none of these containers terminate TLS themselves.
PUBLIC_APP_URL=
PUBLIC_METABASE_URL=
